# MockIQ settings. Copy this file to .env and fill in your key.

# "anthropic" for the real AI interviewer, or "fake" to try the app without a key
LLM_PROVIDER=anthropic

# Your key from https://console.anthropic.com
ANTHROPIC_API_KEY=paste-your-key-here

# Fast model for the live interview, stronger model for scoring
INTERVIEWER_MODEL=claude-haiku-5-5
EVALUATOR_MODEL=claude-sonnet-5-5
EVAL_PASSES=3

# Local database file (or a Postgres URL).
# For throwaway testing, use sqlite:///:memory: so accounts, resumes and interviews
# stay in memory and disappear when the app stops.
DATABASE_URL=sqlite:///./mockiq.db

# Create tester@mockiq.local / test-pass-1 at startup. For local testing only.
SEED_TEST_USER=false

# Set to true only when serving over HTTPS
COOKIE_SECURE=false
